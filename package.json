{
  "name": "sunny-hq",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "Your personal AI studio aboard the Thousand Sunny",
  "author": "Quintin",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "electron .",
    "build": "tsc --noEmit && vite build && node scripts/write-build-info.cjs",
    "test": "node --test tests/*.test.cjs",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "44.4.3",
    "electron-builder": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "build": {
    "appId": "studio.sunny.hq",
    "productName": "Sunny HQ",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "tests/fixtures/playable-local/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ]
  }
}
